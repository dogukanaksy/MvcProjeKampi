@using EntityLayer.Concrete
@model List<Message>
@{
    ViewBag.Title = "Taslaklar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Content Wrapper. Contains page content -->
<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Mesaj Sayfası</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Anasayfa</a></li>
                    <li class="breadcrumb-item active">Taslaklar</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>
<!-- Main content -->
<section class="content">
    <div class="row">
        @Html.Action("MessageListMenu", "Contact")
        <!-- /.col -->
        <div class="col-md-9">
            <div class="card card-primary card-outline">
                <div class="card-header">
                    <h3 class="card-title">Taslaklar</h3>
                </div>
                <!-- /.card-header -->
                <div class="card-body p-0">
                    <div class="mailbox-controls d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("Drafts", "Message")" class="btn btn-default btn-sm" aria-label="Taslak listesini yenile" title="Yenile">
                            <i class="fas fa-sync-alt" aria-hidden="true"></i>
                        </a>
                        <span>@Model.Count taslak</span>
                    </div>
                    <div class="table-responsive mailbox-messages">
                        <table class="table table-hover table-striped">
                            <tbody>
                                @if (Model.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">Henüz taslak yok.</td>
                                    </tr>
                                }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="mailbox-star">
                                            <i class="far fa-file-alt text-muted" aria-hidden="true"></i>
                                        </td>
                                        <td class="mailbox-name">@(string.IsNullOrWhiteSpace(item.ReceiverMail) ? "Alıcı girilmemiş" : item.ReceiverMail)</td>
                                        <td class="mailbox-subject">
                                            <b>@(string.IsNullOrWhiteSpace(item.Subject) ? "Konusuz" : item.Subject)</b> @MvcProjeKampi.Helpers.MessageText.ToPlainText(item.MessageContent)
                                        </td>
                                        <td class="mailbox-date">@item.MessageDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <!-- /.table -->
                    </div>
                    <!-- /.mail-box-messages -->
                </div>
                <!-- /.card-body -->
                <div class="card-footer p-0">
                    <div class="mailbox-controls d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("Drafts", "Message")" class="btn btn-default btn-sm" aria-label="Taslak listesini yenile" title="Yenile">
                            <i class="fas fa-sync-alt" aria-hidden="true"></i>
                        </a>
                        <span>@Model.Count taslak</span>
                    </div>
                </div>
            </div>
            <!-- /.card -->
        </div>
        <!-- /.col -->
    </div>
    <!-- /.row -->
</section>
