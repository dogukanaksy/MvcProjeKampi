
@{
    Layout = null;
}
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<h1>Yeni Kategori Ekleme Sayfası</h1>
<br />
Hoş Geldiniz
. Bu sayfada yeni kategori ekleyebilirsiniz.


<div>
    <form class="form-group" method="post">
        <input type="text" placeholder="Kategori Adı" name="CategoryName" class="form-control" />
        <br />
        <input type="text" placeholder="Açıklama" name="CategoryDescription" class="form-control" />
        <br />
        <div class="checkbox">
            <label>
                @Html.CheckBox("CategoryStatus")
                Kategori aktif olsun
            </label>
        </div>
        <button class="btn btn-primary">Ekle</button>

    </form>
</div>